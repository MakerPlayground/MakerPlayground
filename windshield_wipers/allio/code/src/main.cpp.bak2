// uncomment the following line to print error and debug messages
// #define MP_DEBUG_ENABLE

#include "MakerPlayground.h"
#include "MP_BUTTON_AL.h"
#include "MP_DC_MOTOR.h"
#include "MP_GENERIC_PWM.h"

unsigned long Begin1_recentBlockFinishTime = 0;
unsigned long Begin2_recentBlockFinishTime = 0;
unsigned long* recentBlockFinishTime;
void (*Begin1_currentFn)(void);
void (*Begin1_returnFn)(void);
void (*Begin2_currentFn)(void);
void (*Begin2_returnFn)(void);
void (*currentFn)(void);
void (*returnFn)(void);
MP_BUTTON_AL* Begin1_param1;
MP_BUTTON_AL* Begin1_param2;
MP_BUTTON_AL* Begin1_param3;
MP_BUTTON_AL* Begin1_param4;
MP_BUTTON_AL* Begin1_param5;
MP_DC_MOTOR* Begin1_param6;
MP_GENERIC_PWM* Begin1_param7;
MP_BUTTON_AL* Begin2_param1;
MP_BUTTON_AL* Begin2_param2;
MP_BUTTON_AL* Begin2_param3;
MP_BUTTON_AL* Begin2_param4;
MP_BUTTON_AL* Begin2_param5;
MP_DC_MOTOR* Begin2_param6;
MP_GENERIC_PWM* Begin2_param7;
MP_BUTTON_AL* param1;
MP_BUTTON_AL* param2;
MP_BUTTON_AL* param3;
MP_BUTTON_AL* param4;
MP_BUTTON_AL* param5;
MP_DC_MOTOR* param6;
MP_GENERIC_PWM* param7;

MP_BUTTON_AL _Btn1(2);
MP_BUTTON_AL _Btn2(4);
MP_BUTTON_AL _Btn3(7);
MP_BUTTON_AL _Btn4(A0);
MP_BUTTON_AL _Btn5(A1);
MP_BUTTON_AL _Btn6(A2);
MP_BUTTON_AL _SwA1(8);
MP_BUTTON_AL _SwA2(12);
MP_BUTTON_AL _SwB1(A3);
MP_BUTTON_AL _SwB2(A4);
MP_DC_MOTOR _MotorA(3, 5);
MP_DC_MOTOR _MotorB(9, 10);
MP_GENERIC_PWM _PumpA(6);
MP_GENERIC_PWM _PumpB(11);

void Begin1_begin_options();
void Begin2_begin_options();
void subdiagram_wiper_front_begin_options();
void subdiagram_wiper_front_command_wiper_on_1_options();
void subdiagram_wiper_front_command_wiper_on_2_options();
void subdiagram_wiper_front_command_spray_on_1_options();
void subdiagram_wiper_front_command_wiper_on_3_options();
void subdiagram_wiper_front_subdiagram_wiper_on_motor_cw();
void subdiagram_wiper_front_subdiagram_wiper_on_motor_cw_options();
void subdiagram_wiper_front_subdiagram_wiper_on_motor_ccw();
void subdiagram_wiper_front_subdiagram_wiper_on_motor_ccw_options();
void subdiagram_wiper_front_subdiagram_wiper_on_motor_stop();
void subdiagram_wiper_front_subdiagram_spray_on_pump_on();
void subdiagram_wiper_front_subdiagram_spray_on_pump_on_options();
void subdiagram_wiper_front_subdiagram_spray_on_pump_off();

void setup() {
    MPSerial.begin(115200);

    _Btn1.init();
    _Btn2.init();
    _Btn3.init();
    _Btn4.init();
    _Btn5.init();
    _Btn6.init();
    _SwA1.init();
    _SwA2.init();
    _SwB1.init();
    _SwB2.init();
    _MotorA.init();
    _MotorB.init();
    _PumpA.init();
    _PumpB.init();

    Begin1_currentFn = Begin1_begin_options;
    Begin2_currentFn = Begin2_begin_options;
    // Begin1_currentFn = subdiagram_wiper_front_begin_options;
    // Begin2_currentFn = subdiagram_wiper_front_begin_options;
}

void loop() {
    update();
    param1 = Begin1_param1;
    param2 = Begin1_param2;
    param3 = Begin1_param3;
    param4 = Begin1_param4;
    param5 = Begin1_param5;
    param6 = Begin1_param6;
    param7 = Begin1_param7;
    // param1 = &_Btn1;
    // param2 = &_Btn2;
    // param3 = &_Btn3;
    // param4 = &_SwA1;
    // param5 = &_SwA2;
    // param6 = &_MotorA;
    // param7 = &_PumpA;
    recentBlockFinishTime = &Begin1_recentBlockFinishTime;
    // currentFn = &Begin1_currentFn;
    // returnFn = &Begin1_returnFn;
    returnFn = Begin1_returnFn;
    Begin1_currentFn();
    Begin1_currentFn = currentFn;
    Begin1_returnFn = returnFn;
    param1 = Begin2_param1;
    param2 = Begin2_param2;
    param3 = Begin2_param3;
    param4 = Begin2_param4;
    param5 = Begin2_param5;
    param6 = Begin2_param6;
    param7 = Begin2_param7;
    // param1 = &_Btn4;
    // param2 = &_Btn5;
    // param3 = &_Btn6;
    // param4 = &_SwB1;
    // param5 = &_SwB2;
    // param6 = &_MotorB;
    // param7 = &_PumpB;
    recentBlockFinishTime = &Begin2_recentBlockFinishTime;
    // currentFn = &Begin2_currentFn;
    // returnFn = &Begin2_returnFn;
    returnFn = Begin2_returnFn;
    Begin2_currentFn();
    Begin2_currentFn = currentFn;
    Begin2_returnFn = returnFn;
}

void update() {
    currentTime = millis();

    _Btn1.update(currentTime);
    _Btn2.update(currentTime);
    _Btn3.update(currentTime);
    _Btn4.update(currentTime);
    _Btn5.update(currentTime);
    _Btn6.update(currentTime);
    _SwA1.update(currentTime);
    _SwA2.update(currentTime);
    _SwB1.update(currentTime);
    _SwB2.update(currentTime);
    _MotorA.update(currentTime);
    _MotorB.update(currentTime);
    _PumpA.update(currentTime);
    _PumpB.update(currentTime);
}

void Begin1_begin_options() {
    Begin1_param1 = &_Btn1;
    Begin1_param2 = &_Btn2;
    Begin1_param3 = &_Btn3;
    Begin1_param4 = &_SwA1;
    Begin1_param5 = &_SwA2;
    Begin1_param6 = &_MotorA;
    Begin1_param7 = &_PumpA;
    Begin1_currentFn = subdiagram_wiper_front_begin_options;
}

void Begin2_begin_options() {
    Begin2_param1 = &_Btn4;
    Begin2_param2 = &_Btn5;
    Begin2_param3 = &_Btn6;
    Begin2_param4 = &_SwB1;
    Begin2_param5 = &_SwB2;
    Begin2_param6 = &_MotorB;
    Begin2_param7 = &_PumpB;
    Begin2_currentFn = subdiagram_wiper_front_begin_options;
}

void subdiagram_wiper_front_begin_options() {
    if (param1->isPress()) {
        currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_cw;
        returnFn = subdiagram_wiper_front_command_wiper_on_1_options;
    } else if (param2->isPress()) {
        currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_cw;
        returnFn = subdiagram_wiper_front_command_wiper_on_2_options;
    } else if (param3->isPress()) {
        currentFn = subdiagram_wiper_front_subdiagram_spray_on_pump_on;
        returnFn = subdiagram_wiper_front_command_spray_on_1_options;
    }
}

void subdiagram_wiper_front_command_wiper_on_1_options() {
    if (millis() - *recentBlockFinishTime > 1000) {
        currentFn = subdiagram_wiper_front_begin_options;
    }
}

void subdiagram_wiper_front_command_wiper_on_2_options() {
    if (millis() - *recentBlockFinishTime > 2000) {
        currentFn = subdiagram_wiper_front_begin_options;
    }
}

void subdiagram_wiper_front_command_spray_on_1_options() {
    currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_cw;
    returnFn = subdiagram_wiper_front_command_wiper_on_3_options;
}

void subdiagram_wiper_front_command_wiper_on_3_options() {
    currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_cw;
    returnFn = subdiagram_wiper_front_begin_options;
}

void subdiagram_wiper_front_subdiagram_wiper_on_motor_cw() {
    param6->on(0, 100);
    currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_cw_options;
}

void subdiagram_wiper_front_subdiagram_wiper_on_motor_cw_options() {
    if (param5->isPress()) {
        currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_ccw;
    }
}

void subdiagram_wiper_front_subdiagram_wiper_on_motor_ccw() {
    param6->on(1, 100);
    currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_ccw_options;
}

void subdiagram_wiper_front_subdiagram_wiper_on_motor_ccw_options() {
    if (param4->isPress()) {
        currentFn = subdiagram_wiper_front_subdiagram_wiper_on_motor_stop;
    }
}

void subdiagram_wiper_front_subdiagram_wiper_on_motor_stop() {
    param6->off();
    currentFn = returnFn;
}

void subdiagram_wiper_front_subdiagram_spray_on_pump_on() {
    param7->on(100);
    *recentBlockFinishTime = millis();
    currentFn = subdiagram_wiper_front_subdiagram_spray_on_pump_on_options;
}

void subdiagram_wiper_front_subdiagram_spray_on_pump_on_options() {
    if (millis() - *recentBlockFinishTime > 2000) {
        currentFn = subdiagram_wiper_front_subdiagram_spray_on_pump_off;
    }
}

void subdiagram_wiper_front_subdiagram_spray_on_pump_off() {
    param7->off();
    currentFn = returnFn;
}